{
  "permissions": {
    "deny": [
      "Read(./sandbox/benchmark/payloads/**)",
      "Read(./sandbox/results/raw/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_payload_reads.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
